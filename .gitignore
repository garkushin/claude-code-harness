# Версионируем только то, что писали руками. Всё остальное — состояние харнеса
# (сессии, транскрипты, кеши, телеметрия, установленные плагины) — игнорируем.
/*

!/.gitignore
!/CLAUDE.md
!/settings.json
!/rules/
/skills/
!/skills/synced/
!/README.md
!/mcp/

# Каталоги ручной конфигурации, которых может ещё не быть: без этих строк
# созданный позже ~/.claude/agents молча не попадёт в репозиторий.
!/agents/
!/commands/
!/hooks/
!/keybindings.json

# Локальные оверрайды и машинно-специфичное остаются вне репозитория:
# settings.local.json, .credentials.json — под правилом /* выше.

.DS_Store
