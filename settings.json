{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(glab mr view *)",
      "Bash(glab mr list *)",
      "Bash(glab mr diff *)",
      "Bash(glab ci view *)",
      "Bash(glab ci list *)",
      "Bash(glab issue view *)",
      "Bash(glab issue list *)"
    ],
    "ask": [
      "Bash(glab mr approve *)",
      "Bash(glab mr merge *)",
      "Bash(glab mr note *)",
      "Bash(glab mr create *)",
      "Bash(glab mr update *)",
      "Bash(glab ci run *)",
      "Bash(glab api *)",
      "Bash(git push *)"
    ]
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "api.stage.digital.kfc.ru",
        "api.stage.digital.uni.rest"
      ]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/dotnet-format.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
