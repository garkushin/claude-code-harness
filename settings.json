{
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "api.stage.digital.kfc.ru",
        "api.stage.digital.uni.rest"
      ]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/dotnet-format.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
